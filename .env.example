# Copy this file to .env and replace both passwords with unique, strong values.
MYSQL_DATABASE=crm_app
MYSQL_USER=crm_user
MYSQL_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_UNIQUE_LONG_RANDOM_PASSWORD
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
